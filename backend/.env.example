# Copy to `.env` and adjust as needed. All values are read from the real
# environment (settings.py) — this file is for local dev convenience only,
# loaded via `uvicorn --env-file .env` (see web/README's backend section).

DATABASE_URL=postgresql+psycopg://genesis:genesis@localhost:5432/genesis
REDIS_URL=
ENVIRONMENT=development

# Dev-only placeholder secrets — never reuse these outside a local machine.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-xx
OTP_PEPPER=dev-only-otp-pepper-change-me
# At least 32 bytes of key material (RFC 2104). Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CURSOR_SIGNING_KEY=dev-only-cursor-signing-key-change-me-000
CURSOR_KEY_VERSION=1

# The dev-mode OTP display flag is deliberately NOT listed here: the #35
# tripwire (tests/test_dev_otp_tripwire.py) forbids it on every deployment
# config surface, .env.example included. Testers export it per-shell only.

AUTH_RATE_LIMIT_PER_MINUTE=60
# Pure-IP backstop bucket (applies regardless of the x-tenant-id header).
AUTH_RATE_LIMIT_IP_PER_MINUTE=240
# Comma-separated IPs of trusted reverse-proxy hops (e.g. the Passenger
# host on MochaHost). EMPTY (the safe default) = X-Forwarded-For is never
# trusted and rate buckets key on the direct peer. Set this ONLY to proxy
# addresses you operate; a wrong entry lets that peer spoof client IPs.
TRUSTED_PROXY_IPS=

# Comma-separated browser origins allowed to call this API. Empty = closed.
CORS_ORIGINS=http://localhost:3000
