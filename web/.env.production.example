# Copy to `.env.production` ON THE SERVER before running `npm run build`.
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME (see src/lib/env.ts) — a
# value set only at `next start` time is too late; it must exist when
# `npm run build` runs.

NEXT_PUBLIC_API_BASE_URL=https://api.mydomain.com
# The real tenant uuid, produced by the one-time tenant bootstrap
# (see backend/scripts/provision_tenant.sql and
# docs/technical/mochahost-deployment.md) — not a placeholder like the
# dev fixture id in web/.env.local.
NEXT_PUBLIC_TENANT_ID=
